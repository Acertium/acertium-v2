# AcertiumV2 — variables de entorno. Copia a .env.local y rellena.
# (los agentes NO leen .env.local; ver README y la norma de secretos)

# Supabase — proyecto Acertium-prod. La app V2 usa el schema `acertium_v2`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor — nunca exponer al cliente. Acceso al cerebro (schema acertium_v2).
SUPABASE_SERVICE_ROLE_KEY=

# UID del admin (auth.users.id) para el gate de /admin (fail-closed si vacío).
ADMIN_USER_ID=
